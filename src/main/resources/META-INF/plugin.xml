<idea-plugin>
    <id>ch.brielmayer.bulkmergerequest</id>
    <name>Bulk Merge Requests</name>
    <vendor email="info@brielmayer.ch" url="https://brielmayer.ch">Brielmayer Consulting GmbH</vendor>

    <description><![CDATA[
    Creates merge requests for <b>all open projects</b> in a single dialog.
    <br/><br/>
    Pick the source and target branch per repository, following the layout of the IDE's own Push dialog,
    and confirm once. One merge request is created per selected repository. A repository that fails never
    stops the others: every result is reported together, with direct links to what was created and a clear
    reason for what was not, and the failed ones can be retried in one click.
    <br/><br/>
    Built for workspaces with many repositories: filter the table, set a source or target branch across all
    of them at once, and override it per repository where needed.
    <br/><br/>
    Supported hosts: <b>GitLab</b>, <b>GitHub</b>, <b>Gitea</b> and <b>Forgejo</b>, each on their hosted
    service as well as on your own server. Access tokens are stored in the IDE password safe.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.BulkMergeRequestBundle</resource-bundle>

    <extensionPoints>
        <!-- Additional providers can ship as separate modules or separate plugins. -->
        <extensionPoint
            name="gitHostProvider"
            interface="ch.brielmayer.bulkmergerequest.provider.GitHostProvider"
            dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            id="ch.brielmayer.bulkmergerequest.settings"
            instance="ch.brielmayer.bulkmergerequest.core.settings.BulkMergeRequestConfigurable"
            bundle="messages.BulkMergeRequestBundle"
            key="settings.title"/>

        <notificationGroup
            id="Bulk Merge Requests"
            displayType="STICKY_BALLOON"
            bundle="messages.BulkMergeRequestBundle"
            key="notification.group"/>
    </extensions>

    <extensions defaultExtensionNs="ch.brielmayer.bulkmergerequest">
        <gitHostProvider implementation="ch.brielmayer.bulkmergerequest.provider.gitlab.GitLabProvider"/>
        <gitHostProvider implementation="ch.brielmayer.bulkmergerequest.provider.github.GitHubProvider"/>
        <gitHostProvider implementation="ch.brielmayer.bulkmergerequest.provider.gitea.GiteaProvider"/>
        <gitHostProvider implementation="ch.brielmayer.bulkmergerequest.provider.gitea.ForgejoProvider"/>
    </extensions>

    <actions>
        <action
            id="ch.brielmayer.bulkmergerequest.BulkMergeRequestAction"
            class="ch.brielmayer.bulkmergerequest.core.action.BulkMergeRequestAction"
            icon="AllIcons.Vcs.Merge">
            <!--
              Git.MainMenu is the "Git" menu in the menu bar (attached to VcsGroups by Git4Idea).
              Git.Menu is a different group - the Git submenu of VcsGlobalGroup - and is not visible
              in the default UI.
            -->
            <add-to-group group-id="Git.MainMenu" anchor="after" relative-to-action="Vcs.Push"/>
        </action>
    </actions>
</idea-plugin>
